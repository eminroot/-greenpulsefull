# Copy to .env on the server and fill in. Never commit the real file.

# Domain pointed at this box. Caddy gets the TLS certificate for it.
DOMAIN=greenpulse.example.com

# Only when another web server already owns ports 80 and 443 on this box (the
# shared Contabo VPS): run this stack's Caddy behind it on a loopback port and
# let the front server do TLS. See deploy/host-caddy.example for its half.
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.behind-proxy.yml
# PANEL_PORT=8095

# Signs access tokens. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# Changing it signs every phone out.
GP_SECRET_KEY=

# Postgres password, used by both containers.
POSTGRES_PASSWORD=

# Optional: enables "Continue with Google". The OAuth client id the app uses.
# Leave empty and both clients hide the Google button.
GP_GOOGLE_CLIENT_ID=
GP_GOOGLE_EXTRA_CLIENT_IDS=

# The assistant's model key. It lives here and nowhere else: the app and the
# panel call our own /assistant/chat, so the key is never shipped to a client.
# Leave empty and the assistant reports itself as unavailable.
GP_GEMINI_API_KEY=

# Extra browser origins allowed to call the API. Leave EMPTY: the panel is
# served from the same origin as the API, so nothing cross origin is needed.
# "*" is refused in production, because it is a misconfiguration with
# credentials and it is not needed here.
GP_CORS_ORIGINS=

# Optional rate limit tuning. The defaults suit one greenhouse operation.
# GP_LOGIN_RATE_LIMIT=8
# GP_SIGNUP_RATE_LIMIT=10
# GP_ASSISTANT_RATE_LIMIT=30
