# Copy to .env and edit (setup.sh does the copy for you).
# Load by hand with:  set -a && . ./.env && set +a

# --- model ----------------------------------------------------------------
# greenpulse  = the ML team's trained leaf disease classifier (weights/)
# placeholder = green/brown pixel count, only for testing the wiring
LEAFNODE_MODEL=greenpulse
# What this greenhouse grows: tomato or pepper. It picks the model, and the
# model cannot tell crops apart, so a pepper leaf read by the tomato model
# comes back with a tomato disease name.
LEAFNODE_CROP=tomato
# onnxruntime threads. 0 = every core, right for a Pi that does nothing else.
LEAFNODE_THREADS=0
# Where models.json and the .onnx files live. Blank = pi/weights.
LEAFNODE_WEIGHTS_DIR=

# --- identity -------------------------------------------------------------
LEAFNODE_SITE_ID=site-01

# --- the ESP32 link -------------------------------------------------------
# Shared secret the ESP32 sends as X-Node-Key (NODE_KEY in secrets.h). The Pi
# refuses every frame without it. setup.sh generates one if this is empty.
LEAFNODE_NODE_KEY=

# --- photo on request -----------------------------------------------------
# "Take a photo now" in the app reaches the ESP32 through this Pi. Its address
# is learned from the frames it posts, so these normally stay as they are.
# The camera asked when a request names none: DEVICE_ID in config.h.
LEAFNODE_CAMERA_ID=leafnode-01
# Only if the Pi cannot reach the camera at the address its frames come from,
# e.g. http://192.168.1.124. Blank = learned.
LEAFNODE_CAMERA_URL=

# --- storage --------------------------------------------------------------
LEAFNODE_CAPTURES=data/captures
LEAFNODE_KEEP_CAPTURES=1
LEAFNODE_QUEUE=data/queue.db
LEAFNODE_MAX_IMAGE_BYTES=8388608

# --- upstream server ------------------------------------------------------
# Leave the URL blank to keep everything on the Pi. Both values come from
# pairing the device in the app (Settings > Greenhouse > Pair a device).
LEAFNODE_UPSTREAM_URL=
LEAFNODE_UPSTREAM_TOKEN=
LEAFNODE_UPSTREAM_POLL=5
# 0 = retry forever. Rows the server refuses as malformed go to the
# dead_letter table either way, so they never block the rest of the queue.
LEAFNODE_UPSTREAM_MAX_ATTEMPTS=0
# Send each leaf photo with its reading, so the farmer can see it in the app.
LEAFNODE_UPSTREAM_IMAGES=1
