{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "greenpulse.standard_actuator_request.v1",
  "title": "GreenPulse Standard Actuator Request",
  "description": "AI-to-hardware request contract. It does not authorize direct electrical or physical actuation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "command_id",
    "observation_id",
    "plant_id",
    "action",
    "target",
    "risk_score",
    "confidence",
    "confidence_source",
    "requested_duration_seconds",
    "reason_codes",
    "decision_version",
    "safety_policy_version",
    "mode",
    "test_only",
    "hardware_safety_check_required",
    "direct_electrical_control",
    "relay_or_mosfet_controlled_by_ai",
    "hardware_dispatch_permitted_by_ai",
    "physical_actuation_authorized_by_ai"
  ],
  "properties": {
    "schema_version": {
      "const": "greenpulse.standard_actuator_request.v1"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "plant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "action": {
      "const": "IRRIGATION_REQUEST"
    },
    "target": {
      "const": "MAIN_IRRIGATION_PUMP"
    },
    "risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence_source": {
      "type": "string",
      "minLength": 1
    },
    "requested_duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_version": {
      "type": "string",
      "minLength": 1
    },
    "safety_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "TEST_ONLY",
        "OPERATIONAL_REQUEST"
      ]
    },
    "test_only": {
      "type": "boolean"
    },
    "hardware_safety_check_required": {
      "const": true
    },
    "direct_electrical_control": {
      "const": false
    },
    "relay_or_mosfet_controlled_by_ai": {
      "const": false
    },
    "hardware_dispatch_permitted_by_ai": {
      "const": false
    },
    "physical_actuation_authorized_by_ai": {
      "const": false
    }
  }
}